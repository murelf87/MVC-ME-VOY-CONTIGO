{
  "openapi": "3.0.3",
  "info": {
    "title": "MVC - Me voy contigo API",
    "version": "0.2.0",
    "description": "Contrato estático del bloque actual. El SMS real permanece desactivado hasta configurar un proveedor."
  },
  "paths": {
    "/health/live": {
      "get": {
        "responses": {
          "200": {
            "description": "Process alive"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Database/PostGIS ready"
          },
          "503": {
            "description": "Database/PostGIS not ready"
          }
        }
      }
    },
    "/auth/otp/request": {
      "post": {
        "summary": "Solicita OTP por teléfono",
        "responses": {
          "200": {
            "description": "Challenge creado y enviado por proveedor configurado"
          },
          "503": {
            "description": "Proveedor SMS real no configurado"
          }
        }
      }
    },
    "/auth/otp/verify": {
      "post": {
        "summary": "Verifica OTP y crea sesión",
        "responses": {
          "200": {
            "description": "Sesión creada"
          },
          "401": {
            "description": "OTP inválido"
          },
          "410": {
            "description": "OTP expirado"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Revoca la sesión actual",
        "responses": {
          "204": {
            "description": "Sesión revocada"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Perfil del usuario autenticado",
        "responses": {
          "200": {
            "description": "Perfil y roles"
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada"
          }
        }
      }
    }
  }
}
