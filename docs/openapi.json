      "get": {
        "summary": "Ubicación según nivel de autorización"
      }
    },
    "/v1/live/map": {
      "get": {
        "summary": "Mapa público aproximado por provincia"
      }
    },
    "/v1/trips/{tripId}/chat/{peerUserId}/messages": {
      "get": {
        "summary": "Chat directo autorizado",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Envía mensaje idempotente",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/blocks/{userId}": {
      "put": {
        "summary": "Bloquea usuario",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Desbloquea usuario",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/trips/{tripId}/start": {
      "post": {
        "summary": "Inicia viaje",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/trips/{tripId}/complete": {
      "post": {
        "summary": "Finaliza viaje y clasifica bookings",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/bookings/{bookingId}/pickup-code": {
      "post": {
        "summary": "Pasajero genera código de recogida",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/bookings/{bookingId}/pickup-verify": {
      "post": {
        "summary": "Conductor verifica código de recogida",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  }
}
