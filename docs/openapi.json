{
  "openapi": "3.0.3",
  "info": {
    "title": "MVC - Me voy contigo API",
    "version": "0.7.0",
    "description": "Contrato estático del backend actual. Proveedores externos permanecen desactivados sin credenciales reales."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "MVC opaque session token"
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "Proceso activo"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness PostGIS",
        "responses": {
          "200": {
            "description": "DB/PostGIS listo"
          },
          "503": {
            "description": "No listo"
          }
        }
      }
    },
    "/v1/auth/phone/start": {
      "post": {
        "summary": "Inicia verificación telefónica",
        "responses": {
          "202": {
            "description": "Challenge iniciado"
          },
          "429": {
            "description": "Cooldown"
          },
          "503": {
            "description": "Proveedor SMS no configurado"
          }
        }
      }
    },
    "/v1/auth/phone/verify": {
      "post": {
        "summary": "Verifica teléfono y crea sesión",
        "responses": {
          "200": {
            "description": "Sesión creada"
          },
          "401": {
            "description": "Código inválido/expirado"
          }
        }
      }
    },
    "/v1/auth/session": {
      "get": {
        "summary": "Sesión actual",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Revoca sesión",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Revocada"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Perfil autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil"
          }
        }
      }
    },
    "/v1/me/profile": {
      "patch": {
        "summary": "Actualiza perfil propio",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil actualizado"
          }
        }
      }
    },
    "/v1/me/vehicles": {
      "get": {
        "summary": "Vehículos propios",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Vehículos"
          }
        }
      },
      "post": {
        "summary": "Registra vehículo propio",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Vehículo pendiente de revisión"
          }
        }
      }
    },
    "/v1/me/vehicles/{vehicleId}": {
      "put": {
        "summary": "Actualiza vehículo y reinicia revisión",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Vehículo actualizado"
          },
          "403": {
            "description": "No propietario"
          }
        }
      }
    },
    "/v1/me/documents": {
      "get": {
        "summary": "Metadatos seguros de documentos propios",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Documentos sin claves privadas"
          }
        }
      }
    },
    "/v1/admin/vehicles/{vehicleId}/review": {
      "post": {
        "summary": "Revisión administrativa de vehículo/documentación",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Revisado"
          },
          "403": {
            "description": "Rol insuficiente"
          }
        }
      }
    },
    "/v1/admin/documents/{documentId}/review": {
      "post": {
        "summary": "Revisión administrativa de documento",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Revisado"
          },
          "403": {
            "description": "Rol insuficiente"
          }
        }
      }
    },
    "/v1/me/trips": {
      "get": {
        "summary": "Viajes del conductor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Viajes"
          }
        }
      },
      "post": {
        "summary": "Crea borrador con routing calculado en servidor",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Borrador creado"
          },
          "503": {
            "description": "Maps no configurado"
          }
        }
      }
    },
    "/v1/me/trips/{tripId}/publish": {
      "post": {
        "summary": "Publica viaje propio verificado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Publicado"
          },
          "403": {
            "description": "No propietario"
          }
        }
      }
    },
    "/v1/trips/{tripId}/requests": {
      "post": {
        "summary": "Pasajero solicita plaza",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Solicitud pendiente"
          }
        }
      },
      "get": {
        "summary": "Conductor propietario lista solicitudes",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitudes"
          }
        }
      }
    },
    "/v1/me/ride-requests": {
      "get": {
        "summary": "Solicitudes propias del pasajero",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Solicitudes"
          }
        }
      }
    },
    "/v1/ride-requests/{requestId}/decision": {
      "post": {
        "summary": "Conductor acepta/rechaza; aceptación crea hold transaccional",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Decisión aplicada"
          },
          "409": {
            "description": "Sin capacidad o estado incompatible"
          }
        }
      }
    },
    "/v1/trips/{tripId}/location": {
      "post": {
        "summary": "Conductor publica GPS del viaje activo",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Evento procesado"
          },
          "403": {
            "description": "No es conductor"
          }
        }
      },
      "get": {
        "summary": "Ubicación precisa o aproximada según autorización",
        "responses": {
          "200": {
            "description": "Ubicación"
          }
        }
      }
    },
    "/v1/live/map": {
      "get": {
        "summary": "Mapa público aproximado de viajes activos por provincia",
        "responses": {
          "200": {
            "description": "Posiciones aproximadas"
          }
        }
      }
    }
  }
}
