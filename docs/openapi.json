{
  "openapi": "3.0.3",
  "info": {
    "title": "MVC - Me voy contigo API",
    "version": "0.3.0",
    "description": "Contrato estático del bloque actual. La autenticación usa verificación telefónica mediante proveedor configurable y sesiones opacas revocables."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "MVC opaque session token"
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "responses": {
          "200": {
            "description": "Process alive"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "200": {
            "description": "Database/PostGIS ready"
          },
          "503": {
            "description": "Database/PostGIS not ready"
          }
        }
      }
    },
    "/v1/auth/phone/start": {
      "post": {
        "summary": "Inicia verificación telefónica",
        "responses": {
          "202": {
            "description": "Challenge de verificación iniciado"
          },
          "429": {
            "description": "Reenvío demasiado pronto"
          },
          "503": {
            "description": "Proveedor SMS no configurado"
          }
        }
      }
    },
    "/v1/auth/phone/verify": {
      "post": {
        "summary": "Verifica el código con el proveedor y crea sesión",
        "responses": {
          "200": {
            "description": "Sesión creada"
          },
          "401": {
            "description": "Código inválido o expirado"
          },
          "429": {
            "description": "Demasiados intentos"
          }
        }
      }
    },
    "/v1/auth/session": {
      "get": {
        "summary": "Devuelve la sesión autenticada",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión y roles"
          },
          "401": {
            "description": "Sesión inválida o expirada"
          }
        }
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Revoca la sesión actual",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Sesión revocada"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Perfil del usuario autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil y roles"
          },
          "401": {
            "description": "Sesión ausente, inválida o expirada"
          }
        }
      }
    }
  }
}
