    "/v1/trips/search": {
      "get": {
        "summary": "Busca viajes publicados con disponibilidad por segmentos"
      }
    },
    "/v1/trips/{tripId}/requests": {
      "post": {
        "summary": "Solicita plaza",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "get": {
        "summary": "Conductor lista solicitudes",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/ride-requests": {
      "get": {
        "summary": "Solicitudes propias",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/ride-requests/{requestId}/decision": {
      "post": {
        "summary": "Acepta/rechaza y crea hold al aceptar",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/trips/{tripId}/location": {
      "post": {
        "summary": "Conductor publica GPS",
        "security": [
          {
            "bearerAuth": []
          }
        ]
