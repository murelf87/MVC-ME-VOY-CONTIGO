{
  "openapi": "3.0.3",
  "info": {
    "title": "MVC - Me voy contigo API",
    "version": "0.10.0",
    "description": "Contrato estático resumido del backend validado en CI."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "MVC opaque session token"
      }
    }
  },
  "paths": {
    "/health/live": {
      "get": {
        "summary": "Liveness"
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness PostGIS"
      }
    },
    "/v1/auth/phone/start": {
      "post": {
        "summary": "Inicia verificación telefónica"
      }
    },
    "/v1/auth/phone/verify": {
      "post": {
        "summary": "Verifica teléfono y crea sesión"
      }
    },
    "/v1/auth/session": {
      "get": {
        "summary": "Sesión actual",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "summary": "Revoca sesión",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/me": {
      "get": {
        "summary": "Perfil autenticado",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/profile": {
      "patch": {
        "summary": "Actualiza perfil propio",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/vehicles": {
      "get": {
        "summary": "Vehículos propios",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Registra vehículo",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/vehicles/{vehicleId}": {
      "put": {
        "summary": "Actualiza vehículo y reinicia revisión",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/admin/vehicles/{vehicleId}/review": {
      "post": {
        "summary": "Revisión administrativa de vehículo",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/documents": {
      "get": {
        "summary": "Metadatos seguros de documentos propios",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/admin/documents/{documentId}/review": {
      "post": {
        "summary": "Revisión de documento",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/v1/me/trips": {
      "get": {
        "summary": "Viajes propios del conductor",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Crea viaje con routing de servidor",
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
