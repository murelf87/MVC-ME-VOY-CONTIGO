{
  "name": "mvc-me-voy-contigo-backend",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "node --import tsx --test --test-reporter=spec tests/money.test.ts tests/auth.test.ts tests/maps.test.ts tests/vehicle.test.ts tests/insurance-expiry.test.ts \"tests/unit/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 --test-reporter=spec \"tests/*.integration.test.ts\"",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
