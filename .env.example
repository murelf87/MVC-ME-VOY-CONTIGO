NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://mvc:CHANGE_ME@127.0.0.1:55432/mvc
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Phone verification. Keep disabled until real provider credentials are configured.
# dev_console (NODE_ENV=development only) logs a random code per attempt; see docs/DEV_LOCAL.md.
# Correo para códigos de confirmación y cambio de contraseña: disabled | dev_console (solo NODE_ENV=development)
EMAIL_PROVIDER=disabled
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=1800
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15

# Maps/routing. Keep disabled until a restricted production key is configured.
# dev_local (NODE_ENV=development only) uses a fixed Sevilla gazetteer and estimated routes.
MAPS_PROVIDER=disabled
GOOGLE_MAPS_API_KEY=

# Private photos/documents. Disabled until a private S3-compatible bucket is configured.
PRIVATE_STORAGE_PROVIDER=disabled
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
PRIVATE_UPLOAD_TTL_SECONDS=600

# Automatic insurance expiry OCR. Disabled until a restricted provider key is configured.
INSURANCE_OCR_PROVIDER=disabled
GOOGLE_VISION_API_KEY=

# Pagos (docs/PAYMENTS.md). disabled = ningún cobro ni pago.
PAYMENTS_PROVIDER=disabled
STRIPE_WEBHOOK_SECRET=
