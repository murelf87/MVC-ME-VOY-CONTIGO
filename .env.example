NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgres://mvc:CHANGE_ME@127.0.0.1:55432/mvc
TRUST_PROXY=false
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Phone verification. Keep disabled until real provider credentials are configured.
SMS_PROVIDER=disabled
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SERVICE_SID=
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_CHECK_ATTEMPTS=5
AUTH_SESSION_TTL_SECONDS=2592000

# Maps/routing. Keep disabled until a restricted production key is configured.
MAPS_PROVIDER=disabled
GOOGLE_MAPS_API_KEY=

# Private photos/documents. Disabled until a private S3-compatible bucket is configured.
PRIVATE_STORAGE_PROVIDER=disabled
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
PRIVATE_UPLOAD_TTL_SECONDS=600

# Automatic insurance expiry OCR. Disabled until a restricted provider key is configured.
INSURANCE_OCR_PROVIDER=disabled
GOOGLE_VISION_API_KEY=

# Payments. No provider has been selected yet: the only accepted value is "disabled".
# With "disabled": payment intents, payment methods, refunds and payouts answer 409 PAYMENTS_PROVIDER_DISABLED
# and every webhook is rejected. Never mark anything as paid without a server-confirmed provider event.
PAYMENTS_PROVIDER=disabled
# HMAC secret used to verify signed payment webhooks. If empty, ALL webhooks are rejected.
PAYMENTS_WEBHOOK_SECRET=

# ─── Module tunables (all optional: the value shown is the built-in default) ───────────────────────────────
# trips — seat holds, recurring series, background sweep, rate limits, idempotency
TRIPS_SEAT_HOLD_TTL_SECONDS=900
TRIPS_SERIES_HORIZON_DAYS=28
TRIPS_SWEEP_INTERVAL_SECONDS=30
TRIPS_LIVE_STALE_SECONDS=60
TRIPS_RATE_SEARCH_PER_MINUTE=30
TRIPS_RATE_MAP_PER_MINUTE=60
TRIPS_RATE_PLAN_PER_MINUTE=20
TRIPS_IDEMPOTENCY_TTL_HOURS=24
# Public base URL (CDN / public bucket) that serves APPROVED public profile photos. Empty ⇒ no photo URLs are emitted.
PUBLIC_MEDIA_BASE_URL=
PUBLIC_PHOTO_BASE_URL=
# Public base URL used to build trip-share links (e.g. https://mvc.example/s). Empty ⇒ sharing links are not generated.
PUBLIC_SHARE_BASE_URL=

# live — live trip tracking, arrival detection, route changes, ratings
LIVE_STALE_AFTER_SECONDS=60
LIVE_ARRIVAL_WARNING_SECONDS=300
LIVE_ARRIVED_DISTANCE_M=100
LIVE_STOP_DWELL_SECONDS=60
LIVE_OFF_ROUTE_M=300
LIVE_MATERIAL_SCHEDULE_DELTA_S=180
LIVE_ROUTE_CHANGE_TTL_SECONDS=300
LIVE_RATING_WINDOW_DAYS=14

# trust — signed URL lifetimes for private documents/selfies and public photos
TRUST_SIGNED_URL_TTL_SECONDS=120
TRUST_OWN_PREVIEW_TTL_SECONDS=300
TRUST_PUBLIC_PHOTO_TTL_SECONDS=900
TRUST_VEHICLE_ACTIVITY_FRESHNESS_SECONDS=600

# comms — in-app calls, account deletion grace period, data export, background jobs
COMMS_PEER_CALL_ENABLED=true
COMMS_PEER_CALL_WINDOW_BEFORE_MINUTES=720
COMMS_PEER_CALL_WINDOW_AFTER_MINUTES=180
COMMS_ACCOUNT_DELETION_GRACE_DAYS=14
COMMS_EXPORT_TTL_HOURS=168
COMMS_JOBS_INTERVAL_SECONDS=60
